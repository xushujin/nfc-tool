# release 签名配置（本地通道）
#
# 用法：
#   1. 复制本文件为 keystore.properties（该文件已被 .gitignore 忽略，不会入库）
#   2. 填入下面四项真实值
#   3. 直接执行 ./gradlew :app:assembleRelease
#
# CI 通道不需要本文件，改为注入四个同名环境变量（见 README「签名」章节）：
#   NFC_TOOL_STORE_FILE / NFC_TOOL_STORE_PASSWORD / NFC_TOOL_KEY_ALIAS / NFC_TOOL_KEY_PASSWORD
#
# 生成密钥库：
#   keytool -genkeypair -v -keystore nfc-tool-release.jks \
#     -alias nfc-tool -keyalg RSA -keysize 2048 -validity 10950 \
#     -storetype JKS
#
# 注意：.jks 一旦丢失，已发布的包将永远无法覆盖升级，请务必离线备份。

storeFile=/absolute/path/to/nfc-tool-release.jks
storePassword=change-me
keyAlias=nfc-tool
keyPassword=change-me
